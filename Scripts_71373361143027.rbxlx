function v_u_1.comboValid(p172) -- name: comboValid
	-- upvalues: (copy) v_u_1
	local v173 = v_u_1.Combos
	if type(p172) ~= "table" then
		return false, "bad"
	end
	local v174 = #p172
	if v174 < v173.minSteps or v173.maxSteps < v174 then
		return false, "length"
	end
	for v175 = 1, v174 do
		local v176 = p172[v175]
		if type(v176) ~= "string" or not (v_u_1.Tricks[v176] and v_u_1.released(v176)) then
			return false, "skill"
		end
		if v175 <= 1 then
			continue
		end
		local v177 = v_u_1.ComboLinks[p172[v175 - 1]]
		if v177 and v177[v176] then
			continue
		end
		return false, "link"
	end
	return true
end
function v_u_1.comboLink(p178, p179) -- name: comboLink
	-- upvalues: (copy) v_u_1
	local v180 = v_u_1.ComboLinks[p178[p179]]
	if v180 then
		v180 = v180[p178[p179 + 1]]
	end
	return v180
end
function v_u_1.comboScore(p181) -- name: comboScore
	-- upvalues: (copy) v_u_1
	if not v_u_1.comboValid(p181) then
		return 0
	end
	local v182 = 0
	for _, v183 in p181 do
		v182 = v182 + v_u_1.Tricks[v183].points
	end
	local v184 = v_u_1.Combos.chainBonus[#p181] or 1
	for v185 = 1, #p181 - 1 do
		v184 = v184 * v_u_1.comboLink(p181, v185).bonus
	end
	local v186 = v182 * v184 + 0.5
	return math.floor(v186)
end
function v_u_1.comboMeter(p187) -- name: comboMeter
	-- upvalues: (copy) v_u_1
	local v188 = v_u_1.Stage
	local v189 = {}
	local v190 = v188.periodMin
	local v191 = v188.period - v188.periodStep * (p187 - 1)
	v189.period = math.max(v190, v191)
	local v192 = v188.zoneMin
	local v193 = v188.zone - v188.zoneStep * (p187 - 1)
	v189.zone = math.max(v192, v193)
	return v189
end
function v_u_1.comboNeedle(p194, p195) -- name: comboNeedle
	local v196 = p194 / p195 % 1
	return v196 < 0.5 and v196 * 2 or (1 - v196) * 2
end
function v_u_1.comboVerdict(p197, p198) -- name: comboVerdict
	-- upvalues: (copy) v_u_1
	local v199 = v_u_1.Stage
	local v200 = v_u_1.comboNeedle(p197, p198.period) - 0.5
	local v201 = math.abs(v200)
	local v202 = p198.zone / 2
	if v201 <= v199.frame then
		return "frame", v199.frameMult
	elseif v201 <= v202 then
		return "clean", v199.clean
	elseif v201 <= v202 * v199.good then
		return "good", v199.goodMult
	else
		return "miss", 0
	end
end
function v_u_1.comboName(p203) -- name: comboName
	-- upvalues: (copy) v_u_1
	local v204 = {}
	for _, v207 in p203 do
		local v206 = #v204 + 1
		if v_u_1.Tricks[v207] then
			local v207 = v_u_1.Tricks[v207].name or v207
		end
		v204[v206] = v207
	end
	return table.concat(v204, " > ")
end
