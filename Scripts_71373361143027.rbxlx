local function v_u_210() -- name: testOpenAfter
	-- upvalues: (copy) v_u_1
	local v208 = v_u_1.Halloween
	if not game:GetService("RunService"):IsStudio() then
		return v_u_1.TestPlaces[game.PlaceId] and v208.testOpenAfter or nil
	end
	local v209 = workspace:GetAttribute("DebugHwTestAfter")
	return type(v209) == "number" and v209 and v209 or nil
end
function v_u_1.halloweenOpenAt() -- name: halloweenOpenAt
	-- upvalues: (copy) v_u_210, (copy) v_u_1
	local v211 = v_u_210()
	if not v211 then
		return v_u_1.Halloween.releaseAt
	end
	if not game:GetService("RunService"):IsServer() then
		return workspace:GetAttribute("HwOpenAt") or (1 / 0)
	end
	local v212 = os.time()
	local v213 = time()
	return v212 - math.floor(v213) + v211
end
function v_u_1.halloweenOn() -- name: halloweenOn
	-- upvalues: (copy) v_u_1, (copy) v_u_210
	local v214 = v_u_1.Halloween
	if v214.ended then
		return false
	else
		if game:GetService("RunService"):IsStudio() then
			local v215 = workspace:GetAttribute("DebugHwReleaseAt")
			if type(v215) == "number" then
				return v215 <= os.time()
			end
		end
		if v_u_210() then
			return os.time() >= v_u_1.halloweenOpenAt()
		else
			return v214.live or ((os.time() >= v214.releaseAt or v214.previewInTest and v_u_1.TestPlaces[game.PlaceId] == true) and true or false)
		end
	end
end
v_u_1.Halloween.shopById = {}
for _, v216 in v_u_1.Halloween.shop do
