function v_u_1.hwOwned(p159, p160) -- name: hwOwned
	if p159 then
		p159 = p159:GetAttribute("HwOwned")
	end
	if type(p159) ~= "string" then
		return false
	end
	local v161 = game:GetService("HttpService").JSONDecode
	local v162 = game:GetService("HttpService")
	local v163, v164 = pcall(v161, v162, p159)
	if v163 then
		if type(v164) == "table" then
			v163 = v164[p160] == true
		else
			v163 = false
		end
	end
	return v163
end
function v_u_1.skillKind(p165) -- name: skillKind
	-- upvalues: (copy) v_u_1
	if v_u_1.Exercises[p165] then
		return "exercise", v_u_1.Exercises[p165]
	elseif v_u_1.Tricks[p165] then
		return "trick", v_u_1.Tricks[p165]
	elseif v_u_1.Emotes[p165] then
		return "emote", v_u_1.Emotes[p165]
	else
		return nil
	end
end
function v_u_1.comboSlotOf(p166) -- name: comboSlotOf
	-- upvalues: (copy) v_u_1
	local v167
	if type(p166) == "string" then
		v167 = tonumber(p166:match("^combo:(%d)$"))
	else
		v167 = false
	end
	if not v167 or (v167 < 1 or (v167 > v_u_1.Combos.slots or not v167)) then
		v167 = nil
	end
	return v167
end
function v_u_1.canHotbar(p168) -- name: canHotbar
	-- upvalues: (copy) v_u_1
	if v_u_1.comboSlotOf(p168) then
		return true
	end
	if not v_u_1.released(p168) then
		return false
	end
	local v169, v170 = v_u_1.skillKind(p168)
	local v171
	if v169 == "emote" then
		v171 = true
	elseif v169 == nil then
		v171 = false
	else
		v171 = v170.floor == true
	end
	return v171
end
